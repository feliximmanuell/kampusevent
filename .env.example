# ============================================================
#  KampusEvent - contoh konfigurasi environment
#  Salin file ini menjadi .env lalu ganti nilai rahasianya.
#  JANGAN pernah commit file .env ke repository.
# ============================================================

# ---------- Database ----------
POSTGRES_DB=kampusevent
POSTGRES_USER=kampusevent
POSTGRES_PASSWORD=ganti-dengan-password-kuat
# Di dalam Docker Compose, host database adalah nama service: db
DATABASE_URL=postgresql://kampusevent:ganti-dengan-password-kuat@db:5432/kampusevent?schema=public

# ---------- Backend ----------
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# ---------- Image & registry ----------
GHCR_OWNER=username-github-kalian
IMAGE_TAG=latest

# ---------- Aplikasi ----------
APP_PORT=80
SEED_ON_START=true

# ---------- Tunnel publik (opsional) ----------
# Kosongkan bila tidak ingin menjalankan tunnel.
# Isi "tunnel" untuk ngrok (butuh NGROK_AUTHTOKEN) atau
# "tunnel-cf" untuk Cloudflare Quick Tunnel (tanpa akun, URL berubah tiap restart).
COMPOSE_PROFILES=
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
