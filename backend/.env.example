# Salin menjadi backend/.env untuk menjalankan backend tanpa Docker.
# Saat memakai Docker Compose, nilai ini diambil dari .env di root project.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://kampusevent:ganti-password@localhost:5432/kampusevent?schema=public
JWT_SECRET=development-secret-change-me-please
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
